{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "web": {
        "ClusterId": "web",
        "Order": 100,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "HttpRequest": { "ActivityTimeout": "01:00:00" },
        "Destinations": { "neutron-api": { "Address": "http://neutron-api" } }
      },
      "web": {
        "Destinations": { "neutron-web": { "Address": "http://neutron-web" } }
      }
    }
  }
}
